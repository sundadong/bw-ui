{
  "name": "bwui-uniapp",
  "version": "1.0.0",
  "description": "基于 uni-app 的多端小程序 UI 组件库",
  "main": "dist/build/h5/index.html",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4010520250530001",
    "@dcloudio/uni-components": "3.0.0-4010520250530001",
    "@dcloudio/uni-h5": "3.0.0-4010520250530001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4010520250530001",
    "@dcloudio/uni-mp-alipay": "3.0.0-4010520250530001",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-4010520250530001",
    "@dcloudio/uni-cli-shared": "3.0.0-4010520250530001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4010520250530001",
    "@uni-helper/uni-types": "^1.0.0-alpha.3",
    "@vue/tsconfig": "^0.5.1",
    "sass": "^1.77.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vue-tsc": "^2.0.13"
  }
}
