{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^bw-(.*)": "@/components/$1/index.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "BWUI"
      }
    },
    {
      "path": "pages/basic/button",
      "style": {
        "navigationBarTitleText": "Button 按钮"
      }
    },
    {
      "path": "pages/basic/icon",
      "style": {
        "navigationBarTitleText": "Icon 图标"
      }
    },
    {
      "path": "pages/form/field",
      "style": {
        "navigationBarTitleText": "Field 输入框"
      }
    },
    {
      "path": "pages/form/switch",
      "style": {
        "navigationBarTitleText": "Switch 开关"
      }
    },
    {
      "path": "pages/form/checkbox",
      "style": {
        "navigationBarTitleText": "Checkbox 复选框"
      }
    },
    {
      "path": "pages/form/radio",
      "style": {
        "navigationBarTitleText": "Radio 单选框"
      }
    },
    {
      "path": "pages/form/stepper",
      "style": {
        "navigationBarTitleText": "Stepper 步进器"
      }
    },
    {
      "path": "pages/feedback/popup",
      "style": {
        "navigationBarTitleText": "Popup 弹出层"
      }
    },
    {
      "path": "pages/feedback/dialog",
      "style": {
        "navigationBarTitleText": "Dialog 对话框"
      }
    },
    {
      "path": "pages/feedback/toast",
      "style": {
        "navigationBarTitleText": "Toast 轻提示"
      }
    },
    {
      "path": "pages/feedback/loading",
      "style": {
        "navigationBarTitleText": "Loading 加载"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "BWUI",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f8f8f8"
  },
  "tabBar": {
    "color": "#969799",
    "selectedColor": "#1989fa",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/basic/button",
        "text": "基础"
      },
      {
        "pagePath": "pages/form/field",
        "text": "表单"
      },
      {
        "pagePath": "pages/feedback/popup",
        "text": "反馈"
      }
    ]
  }
}
