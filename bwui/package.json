    "@vitest/coverage-v8": "^1.3.1",
    "@vue/test-utils": "^2.4.5",
    "happy-dom": "^13.6.2",
    "sass": "^1.64.2",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^1.3.1",
    "vue-tsc": "^2.0.7"
  }
}
